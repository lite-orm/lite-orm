<?xml version="1.0" encoding="UTF-8"?>
<mapper namespace="io.github.lynxus.test.xmlresult.FlatResultMapper">
    <resultMap id="recordResult" type="io.github.lynxus.test.xmlresult.FlatResultMapper.UserRecord">
        <constructor>
            <arg column="user_id" javaType="java.lang.Long"/>
            <arg column="user_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="beanResult" type="io.github.lynxus.test.xmlresult.FlatResultMapper.UserBean">
        <id property="id" column="user_id" javaType="java.lang.Long"/>
        <result property="name" column="user_name" javaType="java.lang.String"/>
    </resultMap>

    <resultMap id="scalarResult" type="java.lang.Long">
        <result column="total" javaType="java.lang.Long"/>
    </resultMap>

    <select id="findRecord" resultMap="recordResult">
        SELECT id AS user_id, name AS user_name FROM users
    </select>

    <select id="findBean" resultMap="beanResult">
        SELECT id AS user_id, name AS user_name FROM users
    </select>

    <select id="count" resultMap="scalarResult">
        SELECT count(*) AS total FROM users
    </select>
</mapper>
