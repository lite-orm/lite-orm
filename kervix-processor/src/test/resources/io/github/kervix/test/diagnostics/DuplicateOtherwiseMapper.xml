<?xml version="1.0" encoding="UTF-8"?>
<mapper namespace="io.github.kervix.test.diagnostics.DuplicateOtherwiseMapper">
    <select id="findValue" resultType="io.github.kervix.test.diagnostics.ValueRow">
        SELECT 'value'
        <choose>
            <when test="value != null">WHERE value = #{value}</when>
            <otherwise>WHERE 1 = 1</otherwise>
            <otherwise>WHERE 1 = 0</otherwise>
        </choose>
    </select>
</mapper>
